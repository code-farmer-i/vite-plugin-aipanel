{
  "name": "vite-plugin-aipanel-workspace",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "scripts": {
    "build": "pnpm --filter @aipanel/core build && pnpm --filter @aipanel/provider-opencode build && pnpm --filter @aipanel/provider-deepseek build && pnpm --filter @aipanel/ui build && pnpm --filter vite-plugin-aipanel build && pnpm --filter @aipanel/extension build",
    "build:ui": "pnpm --filter @aipanel/ui build && pnpm --filter @aipanel/extension build",
    "dev:components": "pnpm --filter @aipanel/ui dev:site",
    "dev:docs": "pnpm --filter @aipanel/docs dev",
    "build:docs": "pnpm --filter @aipanel/docs build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "typecheck": "pnpm -r --if-present run typecheck && vue-tsc -p tsconfig.json --noEmit",
    "release": "pnpm test && node scripts/release.js",
    "deploy:docs": "node scripts/deploy-docs.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pagoda-cli/core": "^1.0.23",
    "@pnpm/logger": "1100.0.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.11",
    "enquirer": "^2.4.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.0",
    "vue": "^3.5.39",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.6"
  }
}
