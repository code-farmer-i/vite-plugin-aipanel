{
  "name": "vite-plugin-aipanel-workspace",
  "version": "1.2.0-beta.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "typescript": "^6.0.3",
      "vue-tsc": "^3.3.6"
    },
    "onlyBuiltDependencies": [
      "@vscode/vsce",
      "@vscode/vsce-sign",
      "esbuild",
      "keytar",
      "msgpackr-extract",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "sharp"
    ]
  },
  "scripts": {
    "build": "pnpm --filter @aipanel/core build && pnpm --filter @aipanel/opencode-plugins build && pnpm --filter @aipanel/provider-opencode build && pnpm --filter @aipanel/provider-deepseek build && pnpm --filter @aipanel/ui build && pnpm --filter vite-plugin-aipanel build && pnpm --filter @aipanel/extension build",
    "dev:components": "pnpm --filter @aipanel/ui dev:site",
    "dev:playground": "pnpm --filter @aipanel/docs dev",
    "dev:docs": "pnpm --filter vite-plugin-aipanel site",
    "build:docs": "pnpm --filter @aipanel/docs build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "release": "node scripts/release.js",
    "deploy:docs": "node scripts/deploy-docs.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pagoda-cli/core": "^1.0.23",
    "@pnpm/logger": "1100.0.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "enquirer": "^2.4.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.0",
    "vue": "^3.5.39",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.6"
  }
}
