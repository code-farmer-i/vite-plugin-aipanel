{
  "name": "@aipanel/core",
  "version": "1.2.5",
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "es/index.d.ts",
  "files": [
    "es",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./node": {
      "types": "./es/node.d.ts",
      "import": "./es/node.mjs",
      "require": "./lib/node.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pagoda-cli build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.declaration.json --noEmit"
  },
  "dependencies": {
    "vue-tsc": "^3.3.9"
  }
}
