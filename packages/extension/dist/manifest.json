{
  "manifest_version": 3,
  "name": "OpenCode Assistant",
  "version": "1.1.56",
  "description": "在 localhost 页面中嵌入 OpenCode AI 助手，实现边聊天边改代码的开发体验",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://localhost:*/*",
    "*://127.0.0.1:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://localhost:*/*",
        "*://127.0.0.1:*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OpenCode Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
