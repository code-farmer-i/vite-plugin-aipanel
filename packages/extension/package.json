{
  "name": "@aipanel/extension",
  "version": "1.2.19",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsx scripts/build-bg-cs.ts && cd dist && zip -r ../aipanel-assistant.zip . && cd ..",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aipanel/client": "workspace:*",
    "@aipanel/ui": "workspace:*",
    "@aipanel/core": "workspace:*",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.0"
  }
}
