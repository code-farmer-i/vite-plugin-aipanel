{
  "name": "@aipanel/provider-deepseek",
  "version": "1.1.69",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "files": [
    "es",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pagoda-cli build && node scripts/build-dsh-assets.mjs",
    "typecheck": "tsc -p tsconfig.declaration.json --noEmit"
  },
  "dependencies": {
    "@aipanel/core": "workspace:*",
    "execa": "^9.6.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
