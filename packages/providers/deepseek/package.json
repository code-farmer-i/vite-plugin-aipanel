{
  "name": "@aipanel/provider-deepseek",
  "version": "1.2.24",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "files": [
    "es",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pagoda-cli build && node scripts/build-dsh-assets.mjs",
    "typecheck": "tsc -p tsconfig.declaration.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aipanel/core": "workspace:*",
    "execa": "^9.6.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-brand": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.6-alpha.2",
    "esbuild": "^0.25.0"
  }
}
