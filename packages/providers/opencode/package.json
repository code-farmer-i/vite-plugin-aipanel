{
  "name": "@aipanel/provider-opencode",
  "version": "1.2.6",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "files": [
    "es",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pagoda-cli build",
    "typecheck": "tsc -p tsconfig.declaration.json --noEmit"
  },
  "dependencies": {
    "@aipanel/core": "workspace:*",
    "@opencode-ai/plugin": "^1.18.0",
    "execa": "^9.6.1"
  }
}
