{
  "name": "vite-plugin-aipanel",
  "version": "1.2.0-beta.4",
  "description": "Embed OpenCode Web UI in your Vite dev server for real-time code modification and preview",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "es/index.d.ts",
  "files": [
    "es",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare-eslint-lsp": "node scripts/prepare-eslint-lsp.mjs",
    "build": "pagoda-cli build && vite build -c vite.client.config.ts",
    "dev": "pagoda-cli dev",
    "site": "pagoda-cli site",
    "build:site": "pagoda-cli build-site",
    "typecheck": "tsc -p tsconfig.declaration.json --noEmit"
  },
  "keywords": [
    "vite",
    "plugin",
    "opencode",
    "ai",
    "assistant",
    "chat",
    "hmr",
    "real-time",
    "code-modification"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aipanel/core": "workspace:*",
    "@aipanel/provider-opencode": "workspace:*",
    "@vue/devtools-kit": "^8.0.0",
    "@vue/language-server": "^3.3.7",
    "chrome-devtools-mcp": "1.7.0",
    "execa": "^9.6.1",
    "typescript-language-server": "^5.3.0",
    "unplugin-vue-inspector": "^3.0.0"
  },
  "peerDependencies": {
    "@aipanel/provider-deepseek": "workspace:*",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@aipanel/provider-deepseek": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aipanel/client": "workspace:*",
    "sharp": "^0.34.5"
  }
}
